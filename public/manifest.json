{
  "manifest_version": 3,
  "name": "WebWise — Understand the web",
  "version": "0.1.0",
  "description": "A friendly, privacy-first guide that explains the cookies, permissions and habits behind the websites you visit. Understand the web. Browse with confidence.",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "WebWise",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["cookies", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
