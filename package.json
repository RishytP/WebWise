{
  "name": "webwise",
  "version": "0.1.0",
  "private": true,
  "description": "WebWise — a child-friendly browser safety & privacy extension. Understand the web. Browse with confidence.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-background.mjs",
    "build:fast": "vite build && node scripts/build-background.mjs",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/integration-check.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
