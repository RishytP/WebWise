# Dependencies
node_modules/

# Build output (generated by `npm run build`)
dist/

# Generated icons are intentionally committed so the project builds (and the
# manifest resolves its icon paths) without an extra generation step.
# Regenerate them any time with `npm run icons`.

# Logs & caches
*.log
npm-debug.log*
.vite/
coverage/
*.tsbuildinfo

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Environment files (WebWise needs none; kept here to prevent accidental commits)
.env
.env.local
.env.*.local
